# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# development | testing | production
APP_ENV=development

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Leave empty for local development (uses instance/dev.db SQLite file).
# In production this is your PostgreSQL connection string, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=

# Optional: require SSL when connecting to PostgreSQL over the internet.
# DB_SSLMODE=require

# Optional duplicate-detection tuning
NAME_SIMILARITY_THRESHOLD=0.85
ENABLE_POSSIBLE_DUPLICATE_CHECK=true
MAX_SIMILARITY_CANDIDATES=500
RECORDS_PER_PAGE=10
LOG_LEVEL=INFO
